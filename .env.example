# Anthropic API key for the AI agent proxy (server/routes/agent.js)
ANTHROPIC_API_KEY=

# 공공데이터포털 기상청_단기예보 조회서비스 인증키 (server/routes/weather.js)
KMA_SERVICE_KEY=

# Server port (optional, defaults to 3000)
PORT=3000

# 최초 시스템 어드민(admin) 계정 비밀번호 (선택) — 지정하지 않으면 최초 기동 시 무작위로 생성되어
# 서버 콘솔에 1회만 출력됩니다. (server/db.js)
ADMIN_INITIAL_PASSWORD=
