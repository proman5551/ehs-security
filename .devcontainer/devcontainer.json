{
  "name": "SAFEOPS",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "cd server && npm install",
  "postStartCommand": "cd server && (nohup node index.js > /tmp/safeops-server.log 2>&1 &) && sleep 1",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SAFEOPS 대시보드",
      "onAutoForward": "openPreview"
    }
  }
}
